
{
	"name": "system",
	"description": "Advance system diagnostic",
	"aliases": ["s"],

	"operations": [
		{
			"title": "System information",
			"program": "hostnamectl",
			"command": "hostnamectl",
			
			"handler": "information",

			"presentation": "terminal"
		},

		{
			"title": "Kernel information",
			"program": "uname",
			"command": "uname -a",

			"handler": "information",

			"presentation": "terminal"
		},

		{
			"title": "System state",
			"program": "systemctl",
			"command": "systemctl is-system-running",

			"handler": "equals",
			"expected": "running",

			"presentation": "terminal"
		},

		{
			"title": "Failed system services",
			"program": "systemctl",
			"command": "systemctl --failed --no-pager",

			"handler": "equals",
			"expected": "0 loaded units listed",

			"presentation": "terminal"
		},

		{
			"title": "Package audit",
			"program": "dpkg",
			"command": "dpkg --audit",

			"handler": "empty",

			"presentation": "terminal"
		}
	]
}
