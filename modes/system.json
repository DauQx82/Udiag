
{
	"name": "system",
	"description": "Advance system diagnostic",
	"aliases": ["s"],

	"operations": [
		{
			"title": "System information",
			"program": "hostnamectl",
			"args": [],
			
			"handler": "information",

			"presentation": "terminal"
		},

		{
			"title": "Kernel information",
			"program": "uname",
			"args": ["-a"],

			"handler": "information",

			"presentation": "terminal"
		},

		{
			"title": "System state",
			"program": "systemctl",
			"args": ["is-system-running"],

			"handler": "equals",
			"expected": "running",

			"presentation": "terminal"
		},

		{
			"title": "Failed system services",
			"program": "systemctl",
			"args": ["--failed", "--no-pager"],

			"handler": "equals",
			"expected": "0 loaded units listed",

			"presentation": "terminal"
		},

		{
			"title": "Package audit",
			"program": "dpkg",
			"args": ["--audit"],

			"handler": "empty",

			"presentation": "terminal"
		}
	]
}
